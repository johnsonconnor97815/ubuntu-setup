# ubuntu-setup is a pure bash + markdown project (no Python, no build toolchain).
# Keep this minimal — lib/ and scripts/ are first-class source, never ignored.

# Editor / OS cruft
*.swp
*~
.DS_Store

# Backups produced by lib/common.sh backup_file() if scripts are ever run in-tree
*.bak.*

# Local runtime artifacts (the kit writes logs/config under the user's HOME, not here,
# but guard against stray copies during local testing)
*.log
.cache/

# Local AI dev-workflow scaffolding (Trellis) + code-intel index — not part of the deliverable
.trellis/
.agents/
.codex/
.claude/
.codegraph/
